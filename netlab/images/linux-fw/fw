#!/bin/bash
# fw - a small firewall CLI for the NetLab Linux firewall (nftables underneath).
#
# The configuration is a list of statements, like a Cisco running-config:
#
#   hostname FW1
#   interface eth1 address 10.0.34.2/30
#   interface eth1 zone inside
#   interface eth2 address 203.0.113.1/24
#   interface eth2 zone outside
#   route default via 10.0.34.1            (or: route 10.0.0.0/8 via 10.0.34.1)
#   nat outside masquerade                 (source NAT for traffic leaving "outside")
#   rule 10 permit icmp from inside to outside
#   rule 20 permit tcp from inside to outside port 80,443
#   rule 30 deny any from 192.168.20.0/24 to any
#   default deny                           (forwarded traffic that matched no rule)
#
# How it works:
#   - Rules are checked in sequence order; the first match wins.
#   - The firewall is stateful: replies to allowed traffic are always allowed.
#   - Traffic TO the firewall: ping is answered, everything else is dropped
#     (except eth0, the management network used by the console and SSH).
#   - Every change rebuilds the nftables table "inet netlab" from the list,
#     so "nft list ruleset" (from the "shell" command) shows the result.
#
# In the CLI you type the statements above to add/replace them, "no <statement>"
# to remove one (e.g. "no rule 20"), "show ..." to look, "write" to save.
#
# Usage: fw                 interactive CLI (the console opens it)
#        fw -c "<command>"  run one CLI command
#        fw --load-startup  load /etc/netlab/fw.conf and apply it (used at boot)

source "${NETLAB_LIB:-/usr/local/lib/netlab}/common.sh"

STARTUP=${NETLAB_FW_STARTUP:-/etc/netlab/fw.conf}
RUNNING=$NETLAB_RUN/fw.running
NFT_FILE=$NETLAB_RUN/fw.nft
ERR=""
INTERRUPTED=0

# ------------------------------------------------------------- validation --

is_num()    { [[ $1 =~ ^[0-9]+$ ]]; }
is_ipv4()   {
    [[ $1 =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
    local o; for o in "${BASH_REMATCH[@]:1}"; do ((o <= 255)) || return 1; done
}
is_prefix() {
    [[ $1 =~ ^([0-9.]+)/([0-9]{1,2})$ ]] || return 1
    # Copy the match first: is_ipv4 runs its own regex and overwrites BASH_REMATCH.
    local addr=${BASH_REMATCH[1]} len=${BASH_REMATCH[2]}
    is_ipv4 "$addr" && ((10#$len <= 32))
}
is_zone()   { [[ $1 =~ ^[a-z][a-z0-9_-]{0,30}$ && $1 != any ]]; }
is_addr()   { [[ $1 == any ]] || is_zone "$1" || is_ipv4 "$1" || is_prefix "$1"; }
is_ports()  {
    [[ $1 =~ ^[0-9]+(-[0-9]+)?(,[0-9]+(-[0-9]+)?)*$ ]] || return 1
    local p; for p in ${1//[,-]/ }; do ((p >= 1 && p <= 65535)) || return 1; done
}

RULE_USAGE="usage: rule <seq> permit|deny any|icmp|tcp|udp from <any|zone|prefix> to <any|zone|prefix> [port <p>[,<p>|<a>-<b>]]"

# validate "<statement>": returns 0 if valid, otherwise sets ERR.
validate() {
    local -a w
    read -r -a w <<<"$1"
    case ${w[0]:-} in
        hostname)
            [[ ${#w[@]} == 2 && ${w[1]} =~ ^[A-Za-z0-9_-]+$ ]] || { ERR="usage: hostname <name>"; return 1; } ;;
        interface)
            if [[ ${w[1]:-} == eth0 ]]; then
                ERR="eth0 is the management interface and cannot be configured"; return 1
            fi
            [[ ${w[1]:-} =~ ^eth[1-9][0-9]*$ ]] || { ERR="unknown interface '${w[1]:-}' (lab interfaces are eth1, eth2, ...)"; return 1; }
            case ${w[2]:-} in
                address) { [[ ${#w[@]} == 4 ]] && is_prefix "${w[3]}"; } || { ERR="usage: interface <ethN> address <a.b.c.d/nn>"; return 1; } ;;
                zone)    { [[ ${#w[@]} == 4 ]] && is_zone "${w[3]}"; }   || { ERR="usage: interface <ethN> zone <name> (lowercase letters, digits, - or _)"; return 1; } ;;
                *)       ERR="usage: interface <ethN> address <a.b.c.d/nn>  |  interface <ethN> zone <name>"; return 1 ;;
            esac ;;
        route)
            { [[ ${#w[@]} == 4 && ${w[2]} == via ]] && { [[ ${w[1]} == default ]] || is_prefix "${w[1]}"; } && is_ipv4 "${w[3]}"; } ||
                { ERR="usage: route <a.b.c.d/nn|default> via <gateway>"; return 1; } ;;
        nat)
            { [[ ${#w[@]} == 3 && ${w[2]} == masquerade ]] && is_zone "${w[1]}"; } || { ERR="usage: nat <zone> masquerade"; return 1; } ;;
        rule)
            { [[ ${#w[@]} == 8 || ${#w[@]} == 10 ]] && is_num "${w[1]}" &&
              [[ ${w[2]} =~ ^(permit|deny)$ && ${w[3]} =~ ^(any|icmp|tcp|udp)$ && ${w[4]} == from && ${w[6]} == to ]] &&
              is_addr "${w[5]}" && is_addr "${w[7]}"; } || { ERR=$RULE_USAGE; return 1; }
            if ((${#w[@]} == 10)); then
                { [[ ${w[8]} == port ]] && is_ports "${w[9]}"; } || { ERR=$RULE_USAGE; return 1; }
                [[ ${w[3]} == tcp || ${w[3]} == udp ]] || { ERR="a port can only be used with tcp or udp"; return 1; }
            fi ;;
        default)
            [[ ${#w[@]} == 2 && ${w[1]} =~ ^(permit|deny)$ ]] || { ERR="usage: default permit|deny"; return 1; } ;;
        *)
            ERR="unknown command '${w[0]:-}' (type ? for help)"; return 1 ;;
    esac
}

# The "key" of a statement: a new statement replaces an old one with the
# same key (e.g. "rule 10 ..." replaces the old rule 10).
stmt_key() {
    local -a w
    read -r -a w <<<"$1"
    case ${w[0]:-} in
        hostname) echo hostname ;;
        interface) if [[ ${w[2]:-} == zone ]]; then echo "interface ${w[1]} zone"; else echo "interface ${w[1]:-} address ${w[3]:-}"; fi ;;
        route)    echo "route ${w[1]:-}" ;;
        nat)      echo "nat ${w[1]:-}" ;;
        rule)     echo "rule ${w[1]:-}" ;;
        default)  echo default ;;
    esac
}

# Puts the configuration in a fixed, readable order.
sort_config() {
    awk '
        NF == 0 { next }
        {
            r = 9; k = ""
            if ($1 == "hostname")       r = 0
            else if ($1 == "interface") { r = 1; k = sprintf("%05d %s %s", substr($2, 4) + 0, ($3 == "address") ? "a" : "z", $4) }
            else if ($1 == "route")     { r = 2; k = $2 }
            else if ($1 == "nat")       { r = 3; k = $2 }
            else if ($1 == "rule")      { r = 4; k = sprintf("%010d", $2) }
            else if ($1 == "default")   r = 5
            printf "%d %s\t%s\n", r, k, $0
        }' | sort | cut -f2-
}

# ------------------------------------------------------- config changes --

cfg_set() {                      # add or replace one statement
    local stmt=$1 key line
    key=$(stmt_key "$stmt")
    {
        while IFS= read -r line; do
            [[ -z $line || $(stmt_key "$line") == "$key" ]] && continue
            echo "$line"
        done < "$RUNNING"
        echo "$stmt"
    } | sort_config > "$RUNNING.new"
    mv "$RUNNING.new" "$RUNNING"
}

cfg_del() {                      # remove the statement with the same key
    local key line found=0
    key=$(stmt_key "$1")
    if [[ -z $key ]]; then ERR="nothing to remove"; return 1; fi
    while IFS= read -r line; do
        if [[ $(stmt_key "$line") == "$key" ]]; then found=1; continue; fi
        echo "$line"
    done < "$RUNNING" > "$RUNNING.new"
    mv "$RUNNING.new" "$RUNNING"
    ((found)) || { ERR="'$1' is not in the configuration"; return 1; }
}

# ---------------------------------------------------------------- apply --

# Builds the nftables ruleset from the running configuration.
gen_nft() {
    local -A Z
    local kw ifc what z seq act proto src dst port m action def
    local _from _to _port
    while read -r kw ifc what z; do
        [[ $kw == interface && $what == zone ]] && Z[$z]+="${Z[$z]:+, }\"$ifc\""
    done < "$RUNNING"
    def=$(awk '$1 == "default" {print $2}' "$RUNNING"); def=${def:-deny}

    cat <<'EOF'
table inet netlab
delete table inet netlab
table inet netlab {
    chain input {
        type filter hook input priority filter; policy drop;
        iif "lo" accept
        iifname "eth0" accept comment "management: console and SSH"
        ct state established,related accept
        ct state invalid drop
        meta l4proto { icmp, ipv6-icmp } accept comment "the firewall answers ping"
        counter comment "dropped to firewall"
    }
    chain output {
        type filter hook output priority filter; policy accept;
    }
    chain forward {
        type filter hook forward priority filter; policy drop;
        iifname "eth0" drop comment "management is never routed"
        oifname "eth0" drop
        ct state established,related accept
        ct state invalid drop
EOF
    while read -r kw seq act proto _from src _to dst _port port; do
        [[ $kw == rule ]] || continue
        m=""
        if [[ $src != any ]]; then
            if is_zone "$src"; then
                [[ -n ${Z[$src]:-} ]] || { echo "        # rule $seq skipped: zone '$src' has no interfaces"; continue; }
                m+="iifname { ${Z[$src]} } "
            else
                m+="ip saddr $src "
            fi
        fi
        if [[ $dst != any ]]; then
            if is_zone "$dst"; then
                [[ -n ${Z[$dst]:-} ]] || { echo "        # rule $seq skipped: zone '$dst' has no interfaces"; continue; }
                m+="oifname { ${Z[$dst]} } "
            else
                m+="ip daddr $dst "
            fi
        fi
        case $proto in
            icmp)    m+="meta l4proto icmp " ;;
            tcp|udp) if [[ -n $port ]]; then m+="$proto dport { ${port//,/, } } "; else m+="meta l4proto $proto "; fi ;;
        esac
        if [[ $act == permit ]]; then action=accept; else action=drop; fi
        echo "        ${m}counter $action comment \"rule $seq\""
    done < "$RUNNING"
    if [[ $def == permit ]]; then action=accept; else action=drop; fi
    echo "        counter $action comment \"default $def\""
    echo "    }"
    echo "    chain postrouting {"
    echo "        type nat hook postrouting priority srcnat; policy accept;"
    while read -r kw z what; do
        [[ $kw == nat ]] || continue
        [[ -n ${Z[$z]:-} ]] || { echo "        # nat $z skipped: zone has no interfaces"; continue; }
        echo "        oifname { ${Z[$z]} } masquerade comment \"nat $z\""
    done < "$RUNNING"
    echo "    }"
    echo "}"
}

# Makes the node match the running configuration (addresses, routes, rules).
apply() {
    local ifc want have a dest gw rest name

    name=$(awk '$1 == "hostname" {print $2}' "$RUNNING")
    [[ -n $name ]] && hostname "$name" 2>/dev/null

    # 1) interface addresses
    for ifc in $(lab_ifaces); do
        ip link set "$ifc" up
        want=$(awk -v i="$ifc" '$1 == "interface" && $2 == i && $3 == "address" {print $4}' "$RUNNING")
        have=$(ip -4 -o addr show dev "$ifc" | awk '{print $4}')
        for a in $have; do grep -qxF -- "$a" <<<"$want" || ip addr del "$a" dev "$ifc"; done
        for a in $want; do grep -qxF -- "$a" <<<"$have" || ip addr add "$a" dev "$ifc" || echo "% could not set $a on $ifc"; done
    done
    for ifc in $(awk '$1 == "interface" {print $2}' "$RUNNING" | sort -u); do
        [[ -e $SYSNET/$ifc ]] || echo "% warning: $ifc does not exist on this node (is it linked in the topology?)"
    done

    # 2) static routes (the ones we add are tagged "proto static")
    while read -r dest rest; do
        grep -q "^route $dest via " "$RUNNING" || ip route del "$dest" proto static 2>/dev/null
    done < <(ip -4 route show proto static)
    while read -r dest gw; do
        ip route replace "$dest" via "$gw" proto static 2>/dev/null || echo "% could not add route $dest via $gw (is $gw on a connected network?)"
    done < <(awk '$1 == "route" {print $2, $4}' "$RUNNING")

    # 3) firewall rules and NAT (one atomic nftables transaction)
    gen_nft > "$NFT_FILE"
    if ! nft -f "$NFT_FILE"; then
        echo "% nftables rejected the generated rules ($NFT_FILE)"
        return 1
    fi
}

load_startup() {
    local line n=0 bad=0 stmt
    local -a w
    : > "$RUNNING"
    [[ -f $STARTUP ]] || { apply; return; }
    while IFS= read -r line || [[ -n $line ]]; do
        n=$((n + 1))
        line=${line%%#*}
        read -r -a w <<<"$line"
        ((${#w[@]} == 0)) && continue
        [[ ${w[0]} == "!"* ]] && continue
        stmt="${w[*]}"
        if validate "$stmt"; then
            cfg_set "$stmt"
        else
            echo "% $STARTUP line $n: $ERR"
            bad=1
        fi
    done < "$STARTUP"
    apply || bad=1
    return $bad
}

# A config change: validate, change, apply; undo it if applying fails.
change() {
    local op=$1 stmt=$2
    if [[ $op == set ]] && ! validate "$stmt"; then echo "% $ERR"; return 1; fi
    cp "$RUNNING" "$RUNNING.bak"
    if [[ $op == set ]]; then
        cfg_set "$stmt"
    elif ! cfg_del "$stmt"; then
        echo "% $ERR"; rm -f "$RUNNING.bak"; return 1
    fi
    if ! apply; then
        echo "% change rejected, previous configuration restored"
        mv "$RUNNING.bak" "$RUNNING"
        apply >/dev/null
        return 1
    fi
    rm -f "$RUNNING.bak"
}

# ------------------------------------------------------------------ show --

show_run() {
    echo "! running configuration of $(hostname)"
    cat "$RUNNING"
    awk '$1 == "default" {f = 1} END {if (!f) print "default deny"}' "$RUNNING"
}

show_interfaces() {
    local ifc zone addrs state
    printf '%-10s %-12s %-22s %s\n' "Interface" "Zone" "Address" "Status"
    for ifc in $(lab_ifaces); do
        zone=$(awk -v i="$ifc" '$1 == "interface" && $2 == i && $3 == "zone" {print $4}' "$RUNNING")
        addrs=$(ip -4 -o addr show dev "$ifc" | awk '{print $4}' | paste -sd, -)
        state=$(cat "$SYSNET/$ifc/operstate")
        printf '%-10s %-12s %-22s %s\n' "$ifc" "${zone:--}" "${addrs:--}" "$state"
    done
}

show_routes() {
    echo "Codes: C - connected, S - static (from the configuration)"
    ip -4 route show | grep -v 'dev eth0' | while read -r dest rest; do
        if [[ $rest == *"proto static"* ]]; then
            echo "S    $dest ${rest%% proto*}"
        else
            echo "C    $dest ${rest%% proto*}"
        fi
    done
}

show_rules() {
    local -A hits
    local c p kw seq act proto src dst port _f _t _p def defhits
    while read -r c p; do hits[$c]=$p; done < <(
        nft list chain inet netlab forward 2>/dev/null |
        sed -n 's/.*counter packets \([0-9]*\) bytes [0-9]*.*comment "rule \([0-9]*\)".*/\2 \1/p')
    defhits=$(nft list chain inet netlab forward 2>/dev/null |
        sed -n 's/.*counter packets \([0-9]*\) bytes [0-9]*.*comment "default.*/\1/p')
    def=$(awk '$1 == "default" {print $2}' "$RUNNING"); def=${def:-deny}
    printf '%-6s %-7s %-6s %-18s %-18s %-13s %s\n' "Seq" "Action" "Proto" "Source" "Destination" "Port" "Hits"
    while read -r kw seq act proto _f src _t dst _p port; do
        [[ $kw == rule ]] || continue
        printf '%-6s %-7s %-6s %-18s %-18s %-13s %s\n' "$seq" "$act" "$proto" "$src" "$dst" "${port:--}" "${hits[$seq]:-0}"
    done < "$RUNNING"
    printf '%-6s %-7s %-6s %-18s %-18s %-13s %s\n' "-" "$def" "any" "any" "any" "-" "${defhits:-0}  (default)"
    echo "(Replies to allowed traffic are always allowed: the firewall is stateful.)"
}

show_nat() {
    if ! grep -q '^nat ' "$RUNNING"; then echo "No NAT configured."; return; fi
    grep '^nat ' "$RUNNING"
    echo "(Source NAT: traffic leaving that zone gets the firewall's interface address.)"
}

show_conn() {
    local mgmt
    mgmt=$(ip -4 -o addr show dev eth0 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n1)
    printf '%-6s %-22s %-22s %-12s %s\n' "Proto" "Source" "Destination" "State" "NAT"
    conntrack -L 2>/dev/null | awk -v mgmt="$mgmt" '
        {
            proto = $1; state = ($4 ~ /=/) ? "-" : $4
            delete v; n = 0
            for (i = 1; i <= NF; i++) if (split($i, kv, "=") == 2) { n++; key = kv[1]; if (!(key in v)) v[key] = kv[2]; else if (!((key "2") in v)) v[key "2"] = kv[2] }
            if (v["src"] == mgmt || v["dst"] == mgmt) next
            s = v["src"] ((v["sport"] != "") ? ":" v["sport"] : "")
            d = v["dst"] ((v["dport"] != "") ? ":" v["dport"] : "")
            nat = (v["dst2"] != "" && v["dst2"] != v["src"]) ? "src -> " v["dst2"] : ""
            printf "%-6s %-22s %-22s %-12s %s\n", proto, s, d, state, nat
        }'
}

fw_help() {
    cat <<'EOF'
Configuration (type a statement to add or replace it, "no ..." to remove it):
  hostname <name>
  interface <ethN> address <a.b.c.d/nn>
  interface <ethN> zone <name>
  route <a.b.c.d/nn|default> via <gateway>
  nat <zone> masquerade
  rule <seq> permit|deny any|icmp|tcp|udp from <src> to <dst> [port <ports>]
        <src>/<dst> = any | a zone name | a.b.c.d | a.b.c.d/nn
        <ports>     = 80 | 80,443 | 1000-2000
  default permit|deny
  no <statement>            e.g. "no rule 20", "no route default", "no nat outside"
Show:
  show running-config | startup-config | interfaces | routes | rules | nat | conn
Other:
  write                     save the running config (used at the next start)
  clear counters | clear conn
  ping <ip>, traceroute <ip>
  shell                     Linux shell (try: nft list ruleset)   exit  close session
EOF
}

run_cmd() {
    local -a w
    read -r -a w <<<"$1"
    ((${#w[@]} == 0)) && return 0
    local line="${w[*]}"
    case $line in
        "?"|help)                                   fw_help ;;
        "show run"|"show running"|"show running-config"|"show config") show_run ;;
        "show start"|"show startup"|"show startup-config") cat "$STARTUP" ;;
        "show int"|"show interface"|"show interfaces"|"show ip int"*) show_interfaces ;;
        "show route"|"show routes"|"show ip route")  show_routes ;;
        "show rule"|"show rules"|"show access-list"*) show_rules ;;
        "show nat")                                 show_nat ;;
        "show conn"|"show connections"|"show conntrack") show_conn ;;
        show*)  echo "% show what? running-config startup-config interfaces routes rules nat conn" ;;
        write|"write memory"|wr|save|"copy run start"|"copy running-config startup-config")
            echo "Building configuration..."
            cat "$RUNNING" > "$STARTUP" && echo "[OK]" ;;
        "clear counters")                           apply >/dev/null && echo "Counters cleared." ;;
        "clear conn"|"clear connections")           conntrack -F >/dev/null 2>&1; echo "Connection table cleared." ;;
        "ping "*|"traceroute "*)                    "${w[@]}" ;;
        shell|bash|sh)  echo "(Linux shell; type 'exit' to return to the firewall CLI)"; bash -l ;;
        exit|quit|logout|end)                       exit 0 ;;
        "no "*)                                     change del "${line#no }" ;;
        *)                                          change set "$line" ;;
    esac
}

prompt_name() {
    local n
    n=$(awk '$1 == "hostname" {print $2}' "$RUNNING" 2>/dev/null)
    echo "${n:-$(hostname)}"
}

cli() {
    local line
    trap 'INTERRUPTED=1' INT        # Ctrl+C stops ping/traceroute, not the CLI
    HISTFILE=/root/.fw_history
    set -o history
    history -r 2>/dev/null
    echo "NetLab firewall CLI. Type ? for help."
    while true; do
        INTERRUPTED=0
        if ! IFS= read -e -r -p "$(prompt_name)# " line; then
            if ((INTERRUPTED)); then echo; continue; fi
            echo; exit 0
        fi
        [[ -z ${line//[[:space:]]/} ]] && continue
        history -s "$line"
        history -a 2>/dev/null
        run_cmd "$line"
    done
}

[[ -f $RUNNING ]] || { [[ ${1:-} == --load-startup ]] || load_startup >/dev/null; }

case ${1:-} in
    --load-startup) load_startup ;;
    --apply)        apply ;;
    -c)             shift; run_cmd "$*" ;;
    *)              cli ;;
esac
