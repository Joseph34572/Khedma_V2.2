# Linux scripts and files copied into containers must keep LF line endings,
# even when the repository is checked out on Windows (core.autocrlf=true).
*.sh        text eol=lf
*.py        text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.cfg       text eol=lf
*.conf      text eol=lf
images/**   text eol=lf
wsl/**      text eol=lf
labs/**     text eol=lf
tests/**    text eol=lf
# Windows scripts use CRLF.
*.ps1       text eol=crlf
*.psm1      text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf
