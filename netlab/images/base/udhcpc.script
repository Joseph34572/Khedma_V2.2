#!/bin/sh
# Called by udhcpc (the busybox DHCP client) on every DHCP event.
# udhcpc passes the event name as $1 and the lease details as variables:
#   $interface $ip $mask (prefix length) $subnet $router $dns $domain
#   $serverid $lease
RUN=/run/netlab
LEASE=$RUN/dhcp-$interface.lease

has_ipv4() { ip -4 addr show dev "$interface" | grep -q 'inet '; }

# Windows-style "APIPA": without a DHCP answer, Windows picks 169.254.x.y/16.
# Only the Windows PC image turns this on (NETLAB_APIPA=1).
apipa() {
    mac=$(cat "/sys/class/net/$interface/address")
    a=$(( 0x$(echo "$mac" | cut -d: -f5) ))
    b=$(( 0x$(echo "$mac" | cut -d: -f6) ))
    [ "$a" -lt 1 ] && a=1; [ "$a" -gt 254 ] && a=254
    [ "$b" -lt 1 ] && b=1; [ "$b" -gt 254 ] && b=254
    ip addr add "169.254.$a.$b/16" dev "$interface"
}

# Converts a dotted mask (255.255.255.0) to a prefix length (24).
mask_bits() {
    bits=0
    for octet in $(echo "$1" | tr '.' ' '); do
        case $octet in
            255) bits=$((bits + 8)) ;; 254) bits=$((bits + 7)) ;;
            252) bits=$((bits + 6)) ;; 248) bits=$((bits + 5)) ;;
            240) bits=$((bits + 4)) ;; 224) bits=$((bits + 3)) ;;
            192) bits=$((bits + 2)) ;; 128) bits=$((bits + 1)) ;;
        esac
    done
    echo "$bits"
}

case "$1" in
    deconfig)
        # Lease lost or released: remove the address (and any APIPA address).
        ip -4 addr flush dev "$interface"
        ip link set "$interface" up
        rm -f "$LEASE"
        ;;

    bound|renew)
        prefix=${mask:-$(mask_bits "$subnet")}
        # Only touch the address if it changed (a renew must not cut traffic).
        if ! ip -4 addr show dev "$interface" | grep -q "inet $ip/$prefix "; then
            ip -4 addr flush dev "$interface"
            ip addr add "$ip/$prefix" dev "$interface"
        fi
        ip route del default dev "$interface" 2>/dev/null
        for r in $router; do
            ip route add default via "$r" dev "$interface"
            break
        done
        # DNS from DHCP, unless fixed DNS servers were configured.
        if [ ! -f "$RUN/dns-static" ]; then
            {
                [ -n "$domain" ] && echo "search $domain"
                for d in $dns; do echo "nameserver $d"; done
            } > /etc/resolv.conf
        fi
        cat > "$LEASE" <<EOF
IP=$ip
PREFIX=$prefix
ROUTER="$router"
DNS="$dns"
DOMAIN="$domain"
SERVER=$serverid
LEASE=${lease:-0}
OBTAINED=$(date +%s)
EOF
        rm -f "$RUN/dhcp-$interface.failed"
        ;;

    leasefail|nak)
        date +%s > "$RUN/dhcp-$interface.failed"
        if [ "${NETLAB_APIPA:-0}" = 1 ] && ! has_ipv4; then
            apipa
        fi
        ;;
esac
exit 0
